<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- Row 1 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:orientation="horizontal"
        android:baselineAligned="false"
        android:weightSum="5">

        <!-- 11. Recargar -->
        <LinearLayout
            android:id="@+id/btn_via_refresh"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true">
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/icon_via_refresh"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_action_refresh" />
            <TextView
                android:id="@+id/text_via_refresh"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="Recargar"
                android:textSize="11sp"
                android:gravity="center"
                android:maxLines="1" />
        </LinearLayout>

        <!-- 12. Código fuente -->
        <LinearLayout
            android:id="@+id/btn_via_source"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true">
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/icon_via_source"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_baseline_code" />
            <TextView
                android:id="@+id/text_via_source"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="Código"
                android:textSize="11sp"
                android:gravity="center"
                android:maxLines="1" />
        </LinearLayout>

        <!-- 13. Imprimir / PDF -->
        <LinearLayout
            android:id="@+id/btn_via_print"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true">
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/icon_via_print"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_round_print" />
            <TextView
                android:id="@+id/text_via_print"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="Imprimir"
                android:textSize="11sp"
                android:gravity="center"
                android:maxLines="1" />
        </LinearLayout>

        <!-- 14. Bloqueo de anuncios -->
        <LinearLayout
            android:id="@+id/btn_via_adblock"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true">
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/icon_via_adblock"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_action_block" />
            <TextView
                android:id="@+id/text_via_adblock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="Bloquear ads"
                android:textSize="11sp"
                android:gravity="center"
                android:maxLines="1" />
        </LinearLayout>

        <!-- 15. Limpiar datos -->
        <LinearLayout
            android:id="@+id/btn_via_clear"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true">
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/icon_via_clear"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_action_delete" />
            <TextView
                android:id="@+id/text_via_clear"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="Limpiar"
                android:textSize="11sp"
                android:gravity="center"
                android:maxLines="1" />
        </LinearLayout>
    </LinearLayout>

    <!-- Row 2 empty / spacer to match height -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:layout_marginTop="8dp"
        android:orientation="horizontal"
        android:weightSum="5">
    </LinearLayout>

</LinearLayout>
