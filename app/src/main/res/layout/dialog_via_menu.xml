<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/via_menu_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/dialog_via_menu_bg"
    android:paddingTop="20dp"
    android:paddingBottom="12dp"
    android:paddingStart="8dp"
    android:paddingEnd="8dp">

    <!-- Row 1 (5 items) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:baselineAligned="false"
        android:weightSum="5">

        <!-- 1. Modo nocturno -->
        <LinearLayout
            android:id="@+id/btn_via_night_mode"
            android:layout_width="0dp"
            android:layout_height="72dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true">
            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_via_moon"
                app:tint="#B0B3B8" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Modo nocturno"
                android:textColor="#B0B3B8"
                android:textSize="10.5sp"
                android:gravity="center"
                android:maxLines="2" />
        </LinearLayout>

        <!-- 2. Marcadores -->
        <LinearLayout
            android:id="@+id/btn_via_bookmarks"
            android:layout_width="0dp"
            android:layout_height="72dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true">
            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_bookmark"
                app:tint="#B0B3B8" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Marcadores"
                android:textColor="#B0B3B8"
                android:textSize="10.5sp"
                android:gravity="center"
                android:maxLines="1" />
        </LinearLayout>

        <!-- 3. Historial -->
        <LinearLayout
            android:id="@+id/btn_via_history"
            android:layout_width="0dp"
            android:layout_height="72dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true">
            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_history"
                app:tint="#B0B3B8" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Historial"
                android:textColor="#B0B3B8"
                android:textSize="10.5sp"
                android:gravity="center"
                android:maxLines="1" />
        </LinearLayout>

        <!-- 4. Descargas -->
        <LinearLayout
            android:id="@+id/btn_via_downloads"
            android:layout_width="0dp"
            android:layout_height="72dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true">
            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_file_download_black"
                app:tint="#B0B3B8" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Descargas"
                android:textColor="#B0B3B8"
                android:textSize="10.5sp"
                android:gravity="center"
                android:maxLines="1" />
        </LinearLayout>

        <!-- 5. Modo incógnito -->
        <LinearLayout
            android:id="@+id/btn_via_incognito"
            android:layout_width="0dp"
            android:layout_height="72dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true">
            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/incognito_mode"
                app:tint="#B0B3B8" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Modo incógnito"
                android:textColor="#B0B3B8"
                android:textSize="10.5sp"
                android:gravity="center"
                android:maxLines="2" />
        </LinearLayout>
    </LinearLayout>

    <!-- Row 2 (5 items) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal"
        android:baselineAligned="false"
        android:weightSum="5">

        <!-- 6. Compartir -->
        <LinearLayout
            android:id="@+id/btn_via_share"
            android:layout_width="0dp"
            android:layout_height="72dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true">
            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_share_black"
                app:tint="#B0B3B8" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Compartir"
                android:textColor="#B0B3B8"
                android:textSize="10.5sp"
                android:gravity="center"
                android:maxLines="1" />
        </LinearLayout>

        <!-- 7. Añadir marcador -->
        <LinearLayout
            android:id="@+id/btn_via_add_bookmark"
            android:layout_width="0dp"
            android:layout_height="72dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true">
            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_action_star"
                app:tint="#B0B3B8" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Añadir marcador"
                android:textColor="#B0B3B8"
                android:textSize="10.5sp"
                android:gravity="center"
                android:maxLines="2" />
        </LinearLayout>

        <!-- 8. Sitio de escritorio -->
        <LinearLayout
            android:id="@+id/btn_via_desktop"
            android:layout_width="0dp"
            android:layout_height="72dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true">
            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_action_desktop"
                app:tint="#B0B3B8" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Sitio de escritorio"
                android:textColor="#B0B3B8"
                android:textSize="10.5sp"
                android:gravity="center"
                android:maxLines="2" />
        </LinearLayout>

        <!-- 9. Herramientas -->
        <LinearLayout
            android:id="@+id/btn_via_tools"
            android:layout_width="0dp"
            android:layout_height="72dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true">
            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_page_tools"
                app:tint="#B0B3B8" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Herramientas"
                android:textColor="#B0B3B8"
                android:textSize="10.5sp"
                android:gravity="center"
                android:maxLines="1" />
        </LinearLayout>

        <!-- 10. Ajustes -->
        <LinearLayout
            android:id="@+id/btn_via_settings"
            android:layout_width="0dp"
            android:layout_height="72dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true">
            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_settings_customize"
                app:tint="#B0B3B8" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Ajustes"
                android:textColor="#B0B3B8"
                android:textSize="10.5sp"
                android:gravity="center"
                android:maxLines="1" />
        </LinearLayout>
    </LinearLayout>

    <!-- Bottom Action Row -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="16dp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">

        <!-- Exit Button (left) -->
        <ImageView
            android:id="@+id/btn_via_exit"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="6dp"
            android:src="@drawable/ic_via_power"
            app:tint="#B0B3B8"
            android:clickable="true"
            android:focusable="true" />

        <!-- Pagination dots (center) -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="• • •"
            android:textColor="#505358"
            android:textSize="12sp"
            android:letterSpacing="0.2" />

        <!-- Close Button (right) -->
        <ImageView
            android:id="@+id/btn_via_close"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="6dp"
            android:src="@drawable/ic_via_chevron_down"
            app:tint="#B0B3B8"
            android:clickable="true"
            android:focusable="true" />
    </RelativeLayout>

</LinearLayout>
