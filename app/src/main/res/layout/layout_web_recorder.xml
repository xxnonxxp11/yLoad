<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/banner_web_recorder"
    android:layout_width="match_parent"
    android:layout_height="44dp"
    android:layout_above="@id/bottom_navigation"
    android:background="#1C1D22"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingEnd="8dp"
    android:visibility="gone"
    android:elevation="6dp">

    <View
        android:id="@+id/indicator_recording_dot"
        android:layout_width="10dp"
        android:layout_height="10dp"
        android:background="@drawable/circle_red" />

    <TextView
        android:id="@+id/text_recorder_status"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="Grabando juego web (0 recursos)..."
        android:textColor="#FFFFFF"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/btn_stop_recorder"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:gravity="center"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:text="Detener y Guardar"
        android:textColor="#5C87F7"
        android:textStyle="bold"
        android:textSize="12sp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:focusable="true" />
</LinearLayout>
